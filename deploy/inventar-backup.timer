# Runs inventar-backup.service nightly; Persistent catches up on a run missed while the Pi was off.
# Enable: sudo systemctl enable --now inventar-backup.timer
[Unit]
Description=Nightly Wohnungsinventar backup

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
