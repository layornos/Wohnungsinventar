# Configuration of the inventory server on the Pi, see README ("Betrieb auf dem Pi").
# Copy to /home/layornos/inventar/inventar.env and restrict it: chmod 600 inventar.env
# Never commit the real file, it holds the SMTP password and the Anthropic API key.

# Only reachable through the local Caddy, which terminates TLS (ADR-0005).
INVENTAR_ADDR=127.0.0.1:8080
INVENTAR_DATA_DIR=/home/layornos/inventar/data
INVENTAR_BEHIND_PROXY=true

# Optional, default 20.
#INVENTAR_MAX_PHOTO_MB=20

# Mail delivery; without INVENTAR_SMTP_HOST mails only end up in the log.
#INVENTAR_SMTP_HOST=smtp.gmail.com
#INVENTAR_SMTP_PORT=587
#INVENTAR_SMTP_USER=someone@gmail.com
#INVENTAR_SMTP_PASSWORD=
#INVENTAR_SMTP_FROM=someone@gmail.com

# Do not set INVENTAR_DUCKDNS_DOMAIN/INVENTAR_DUCKDNS_TOKEN here: behind the proxy Caddy
# obtains the certificate, and the server refuses to start with both.

# Name and description suggestions from the first photo with Claude (ADR-0006). Without the key
# the feature is off and no photo leaves the Pi. The key is never logged.
#INVENTAR_ANTHROPIC_API_KEY=
# Optional, default claude-haiku-5-5.
#INVENTAR_ANTHROPIC_MODEL=claude-haiku-5-5
